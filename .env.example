DATABASE_URL="file:./dev.db"

# Auth — required in production (use a long random string)
JWT_SECRET="change-me-to-a-long-random-string"
# Alias also accepted:
# AUTH_SECRET="change-me-to-a-long-random-string"

# Optional extra pepper for hashing OTP codes (defaults to JWT_SECRET)
OTP_PEPPER=

APP_URL="http://localhost:3000"
APP_NAME="روان‌سنج"

# --- SMS provider (abstraction) ---
# Preferred generic names:
SMS_API_KEY=
SMS_SENDER=
# Legacy Kavenegar aliases (still supported):
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Leave empty for development: OTP is logged to the server console and returned as devCode

# --- ZarinPal ---
ZARINPAL_MERCHANT_ID=
# Optional callback override (defaults to APP_URL/api/payment/callback)
ZARINPAL_CALLBACK_URL=
# Set true to use ZarinPal sandbox endpoints
ZARINPAL_SANDBOX=false
# Leave ZARINPAL_MERCHANT_ID empty for simulated DEV payments locally

# --- Email SMTP (optional; currently logs if unset / stub) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Mizoon <noreply@mizoon.local>"
